PORT=3000

# SQL Server — 기본 인스턴스만 쓰는 경우
# DB_SERVER=127.0.0.1
# DB_PORT=1433

# SQL Server Express — 구성 관리자 TCP/IP → IPAll 의 포트를 DB_PORT에 넣는 것을 권장
DB_SERVER=127.0.0.1
DB_PORT=64202
# 포트를 넣으면 Node는 직접 TCP 연결(SQL Browser 불필요). 포트 없이만 쓸 때만 아래 사용:
# DB_INSTANCE=SQLEXPRESS

DB_USER=sa
DB_PASSWORD=1234
DB_NAME=findeatDb

# TLS (로컬 SQLEXPRESS는 보통 아래 조합)
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# 예전 이름 호환
# DB_HOST → DB_SERVER 와 동일 역할

# --- MariaDB (현재 server.js 기본) ---
# DB_SERVER=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=terp_db
# 새 DB 전체: sql/schema_mariadb.sql 만 실행 (USE DB 이름 = DB_NAME). 마이그레이션은 **안 함**.
# 이미 예전 DDL 로 테이블만 있는 경우(한 번만, 빠진 것부터 순서대로):
#   1) sql/migration_mariadb_restaurants_source.sql
#   2) sql/migration_mariadb_restaurants_rating.sql
#   3) sql/migration_mariadb_restaurants_is_matjip.sql
#   4) sql/migration_mariadb_restaurants_user_touched_at.sql
#   5) 위·경도가 정수라 37·127만 저장되면: sql/migration_mariadb_restaurants_latlng_decimal.sql → 네이버 재수입

# --- 네이버 지역 검색 (개발자센터 > 검색 앱에서 발급) ---
# 1) 아래 두 줄에 Client ID / Client Secret 붙여넣기 (GitHub·채팅에 올리지 말 것)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# 2) 키만 먼저 검증 (DB 없이 API 1회 호출)
#    npm run verify:naver
#    선택: NAVER_VERIFY_QUERY=테헤란로 음식점
# 3) 네이버에 검색할 문구(쉼표 구분) — 「어떤 식당을 찾을지」만 정합니다
#    API는 검색어당 최대 5건만 반환합니다. 최신화는 기본 검색어 + 한식·중식 등 변형 검색으로 최대 50건까지 채웁니다.
# NAVER_IMPORT_QUERIES=대륭테크노타운19차 주변 식당,가산디지털단지 음식점
# NAVER_IMPORT_TARGET=50
# 3-1) **회사 위치(거리·도보 계산 출발지)** — 대륭테크노타운19차는 금천구 가산(위도 37.47x, 경도 126.88x)
#      네이버 지도에서 건물 위치 우클릭 → 좌표 복사. LAT=위도, LNG=경도 (127.x 를 LAT 에 넣지 말 것)
#      아래 숫자는 예시입니다. 반드시 지도에서 본인 회사 핀 좌표로 바꾸세요.
# NAVER_REFERENCE_LAT=37.4770
# NAVER_REFERENCE_LNG=126.8890
# --- TMAP 보행 경로 (https://openapi.sk.com/ 앱 등록 → appKey) ---
# 도보 분·거리를 실제 보행 경로로 계산합니다. 없으면 직선+추정(기존 방식)으로 폴백.
# TMAP_APP_KEY=
# TMAP_REQUEST_DELAY_MS=150
# TMAP_START_NAME=회사
# TMAP_USE_WALK=1
# 도보 분 보정: 10분 미만 TMAP 그대로, 10분 이상은 신호 가산 + 전체 3분
# TMAP_WALK_SHORT_MAX_MIN=10
# TMAP_WALK_SIGNAL_EVERY_MIN=6
# TMAP_WALK_SIGNAL_WAIT_MIN=1
# TMAP_WALK_BASE_EXTRA_MIN=3
# 키 확인: npm run verify:tmap
# (선택) 테스트 도착 좌표: TMAP_VERIFY_END_LAT=37.478 TMAP_VERIFY_END_LNG=126.890

# 4) MariaDB(DB_*) 설정 후
#    npm run import:naver
#    기준점(LAT/LNG)만 고친 뒤 DB 거리·도보를 다시 맞출 때: npm run recalc:naver-distances
