PORT=3000

# SQL Server — 기본 인스턴스만 쓰는 경우
# DB_SERVER=127.0.0.1
# DB_PORT=1433

# SQL Server Express — 구성 관리자 TCP/IP → IPAll 의 포트를 DB_PORT에 넣는 것을 권장
DB_SERVER=127.0.0.1
DB_PORT=64202
# 포트를 넣으면 Node는 직접 TCP 연결(SQL Browser 불필요). 포트 없이만 쓸 때만 아래 사용:
# DB_INSTANCE=SQLEXPRESS

DB_USER=sa
DB_PASSWORD=1234
DB_NAME=findeatDb

# TLS (로컬 SQLEXPRESS는 보통 아래 조합)
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# 예전 이름 호환
# DB_HOST → DB_SERVER 와 동일 역할

# --- MariaDB (현재 server.js 기본) ---
# DB_SERVER=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=terp_db
# 새 DB 전체: sql/schema_mariadb.sql 실행 (파일 안 USE DB 이름을 DB_NAME 과 맞출 것)
# 이미 예전 DDL 로 테이블만 있는 경우(한 번만): 아래 마이그레이션 순서대로
# 출처 컬럼 추가(한 번만): sql/migration_mariadb_restaurants_source.sql 실행
# 목록 우선 정렬용(한 번만): sql/migration_mariadb_restaurants_user_touched_at.sql 실행
# 별점 컬럼(한 번만): sql/migration_mariadb_restaurants_rating.sql 실행
# 맛집 표시 컬럼(한 번만): sql/migration_mariadb_restaurants_is_matjip.sql 실행

# --- 네이버 지역 검색 (개발자센터 > 검색 앱에서 발급) ---
# 1) 아래 두 줄에 Client ID / Client Secret 붙여넣기 (GitHub·채팅에 올리지 말 것)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# 2) 키만 먼저 검증 (DB 없이 API 1회 호출)
#    npm run verify:naver
#    선택: NAVER_VERIFY_QUERY=테헤란로 음식점
# 3) DB에 넣을 검색어들(쉼표 구분). 회사 근처는 지명+음식점 등 여러 개를 두는 것을 권장
# NAVER_IMPORT_QUERIES=역삼동 음식점,강남구 한식
# 4) MariaDB(DB_*) 설정 후
#    npm run import:naver
